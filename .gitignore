# Android & Gradle Git Ignore Rule Set

# Built application files
*.apk
*.aab
*.ap_
*.dex

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
build/
app/build/
.gradle/
captures/
.externalNativeBuild
.cxx/

# Local configuration file (sdk path, etc)
local.properties

# Android Studio / IntelliJ IDEA files
.idea/
*.iml
*.iws
*.ipr
.idea/caches/
.idea/libraries/
.idea/modules.xml
.idea/workspace.xml
.idea/navEditor.xml
.idea/assetWizardSettings.xml
.idea/compiler.xml
.idea/gradle.xml
.idea/jarRepositories.xml
.idea/misc.xml
.idea/vcs.xml

# Keystore files
*.jks
*.keystore

# Log files
*.log

# OS generated files
.DS_Store
Thumbs.db

# Antigravity temporary brain/scratch directories
.gemini/
